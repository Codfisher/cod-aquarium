{
  "name": "cod-aquarium",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nuxt dev --port 3030 --host",
    "lint": "node scripts/lint.mjs",
    "lint:oxc": "oxlint",
    "lint:vue": "eslint \"**/*.vue\"",
    "lint:fix": "node scripts/lint.mjs --fix",
    "typecheck": "npx vue-tsc --noEmit -p .nuxt/tsconfig.app.json",
    "task:process-meme": "npx vite-node site/scripts/process-meme-img-v2.ts",
    "task:review-meme": "npx vite-node site/scripts/review-meme.ts --",
    "task:rebuild-meme-asset": "npx vite-node site/scripts/rebuild-meme-asset.ts",
    "task:apply-meme-emotion": "npx vite-node site/scripts/apply-meme-emotion.ts",
    "task:check-meme-index": "npx vite-node site/scripts/check-meme-search-index.ts",
    "task:generate-meme-og": "npx vite-node site/scripts/generate-meme-cache-og.ts",
    "build": "nuxt generate && vite-node site/scripts/postbuild.ts",
    "preview": "pnpm run build && wrangler pages dev dist --port 4173",
    "server:generate": "drizzle-kit generate",
    "server:test": "vitest --config vitest.server.config.ts",
    "server:migrate": "wrangler d1 migrations apply cod-aquarium --remote",
    "server:migrate:local": "wrangler d1 migrations apply cod-aquarium --local",
    "server:preview": "wrangler pages dev",
    "postinstall": "nuxt prepare"
  },
