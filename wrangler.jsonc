{
  "$schema": "node_modules/wrangler/config-schema.json",
  /**
   * Cloudflare Pages 專案設定（網站與 /api 同一個專案）
   *
   * 有 pages_build_output_dir 時，此檔是 Pages 專案的唯一設定來源，
   * 控制台上的相容日期、bindings 等欄位會變成唯讀。
   * Pages 不支援 main、workers_dev、observability 等 Workers 專用欄位，不要加回來。
   * COOKIE_SECRET 是 secret，不寫在這裡，要在 Pages 專案的控制台設定；本機開發放 .dev.vars
   */
  "name": "cod-aquarium",
  "pages_build_output_dir": "./dist",
  /** 不要晚於本機 wrangler 內建 workerd 的版本，否則 nuxt dev 的 getPlatformProxy 會警告並退回舊日期 */
  "compatibility_date": "2025-09-24",
  /** Nitro 的 cloudflare-pages 輸出依賴 Node.js 相容層（Buffer 等） */
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cod-aquarium",
      "database_id": "dc365117-bea4-4ca0-8cb8-8b548e567f81",
      "migrations_dir": "./server/drizzle"
    }
  ]
}
