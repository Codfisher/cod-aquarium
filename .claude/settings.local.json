{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(ls *)",
      "WebFetch",
      "Bash(xargs grep:*)",
      "WebFetch(domain:cucumber.io)",
      "WebFetch(domain:dannorth.net)",
      "Bash(echo \"EXIT_CODE=$?\")",
      "Bash(grep -c \"^ok \" /tmp_ci_output.txt)",
      "Bash(grep -i \"error\" /tmp_ci_output.txt)"
    ]
  }
}
