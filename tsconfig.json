{
  // Nuxt 4 的專案參照寫法：各執行環境的設定由 nuxt prepare 產生於 .nuxt/
  // web、content、site 不在 Nuxt 預設的 app 範圍內，由 nuxt.config.ts 的 typescript.tsConfig.include 補上
  "files": [],
  "references": [
    { "path": "./.nuxt/tsconfig.app.json" },
    { "path": "./.nuxt/tsconfig.server.json" },
    { "path": "./.nuxt/tsconfig.shared.json" },
    { "path": "./.nuxt/tsconfig.node.json" }
  ]
}
